page {
  background: #F8F5F0;
  color: #332720;
  font-family: "Songti SC", "Noto Serif SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1.7;
}

.paper {
  min-height: 100vh;
  padding: 44rpx 36rpx 100rpx;
  box-sizing: border-box;
}

.rule-line {
  height: 1rpx;
  background: #DED5C8;
}

.num {
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: 1rpx;
}

.income {
  color: #8B691C;
}

.outgo {
  color: #C4432B;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border: 1rpx solid #DED5C8;
  color: #5F5246;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.chip-on {
  border-color: #332720;
  background: #332720;
  color: #F8F5F0;
}

.btn-primary {
  background: #332720;
  color: #F8F5F0;
  border-radius: 2rpx;
  letter-spacing: 8rpx;
}

.btn-primary::after {
  border: none;
}

.section-label {
  margin: 48rpx 0 24rpx;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: #8B691C;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #756A5E;
}
