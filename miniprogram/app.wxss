page {
  background: #FBF5EB;
  color: #4A2E1C;
  font-family: "Songti SC", "Noto Serif SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1.7;
}

.paper {
  min-height: 100vh;
  padding: 44rpx 36rpx 100rpx;
  box-sizing: border-box;
}

.rule-line {
  height: 1rpx;
  background: #E3D2BA;
}

.num {
  font-family: Georgia, "Times New Roman", serif;
  letter-spacing: 1rpx;
}

.income {
  color: #D98324;
}

.outgo {
  color: #BF512B;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border: 1rpx solid #E3D2BA;
  color: #7A624C;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.chip-on {
  border-color: #4A2E1C;
  background: #4A2E1C;
  color: #FBF5EB;
}

.btn-primary {
  background: #4A2E1C;
  color: #FBF5EB;
  border-radius: 2rpx;
  letter-spacing: 8rpx;
}

.btn-primary::after {
  border: none;
}

.section-label {
  margin: 48rpx 0 24rpx;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: #D98324;
}

.empty {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9C8A76;
}
