.head {
  padding-bottom: 28rpx;
}

.head-sub {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #756A5E;
}

.head-title {
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #DED5C8;
  border-bottom: 1rpx solid #DED5C8;
}

.nav-btn {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #5F5246;
  border: 1rpx solid #DED5C8;
}

.nav-current {
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.total-card {
  margin-top: 36rpx;
  padding: 40rpx 34rpx;
  background: #332720;
  color: #F8F5F0;
}

.total-caption {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #C9BCAC;
}

.total-big {
  margin-top: 12rpx;
  font-size: 76rpx;
  line-height: 1.25;
}

.total-split {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #5A4A3C;
  font-size: 24rpx;
  color: #C9BCAC;
}

.bar-item {
  margin-bottom: 28rpx;
}

.bar-top {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.bar-track {
  margin-top: 12rpx;
  height: 14rpx;
  background: #EDE7DE;
}

.bar-fill {
  height: 14rpx;
  background: #C4432B;
}

.bar-fill-alt {
  background: #8B691C;
}

.foot-note {
  margin-top: 72rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #756A5E;
}
