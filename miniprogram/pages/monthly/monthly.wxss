.head {
  padding-bottom: 28rpx;
}

.head-sub {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #9C8A76;
}

.head-title {
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #E3D2BA;
  border-bottom: 1rpx solid #E3D2BA;
}

.nav-btn {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #7A624C;
  border: 1rpx solid #E3D2BA;
}

.nav-current {
  font-size: 32rpx;
  letter-spacing: 4rpx;
}

.total-card {
  margin-top: 36rpx;
  padding: 40rpx 34rpx;
  background: #4A2E1C;
  color: #FBF5EB;
}

.total-caption {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #E4CDB0;
}

.total-big {
  margin-top: 12rpx;
  font-size: 76rpx;
  line-height: 1.25;
}

.total-split {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #6B4A2E;
  font-size: 24rpx;
  color: #E4CDB0;
}

.bar-item {
  margin-bottom: 28rpx;
}

.bar-top {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.bar-track {
  margin-top: 12rpx;
  height: 14rpx;
  background: #F0E4D2;
}

.bar-fill {
  height: 14rpx;
  background: #BF512B;
}

.bar-fill-alt {
  background: #D98324;
}

.foot-note {
  margin-top: 72rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #9C8A76;
}
