.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 28rpx;
}

.head-sub {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #9C8A76;
}

.head-title {
  margin-top: 10rpx;
  font-size: 58rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
}

.month-chip {
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid #E3D2BA;
  font-size: 24rpx;
  color: #7A624C;
}

.summary-row {
  display: flex;
  margin-top: 36rpx;
  align-items: stretch;
}

.summary-main {
  width: 62%;
  padding: 36rpx 30rpx 30rpx;
  background: #4A2E1C;
  color: #FBF5EB;
  box-sizing: border-box;
}

.summary-caption {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #E4CDB0;
}

.summary-big {
  margin-top: 16rpx;
  font-size: 64rpx;
  line-height: 1.2;
}

.summary-foot {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #E4CDB0;
}

.summary-side {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.side-cell {
  flex: 1;
  padding: 18rpx 20rpx;
  background: #FFFBF4;
  border: 1rpx solid #F0E4D2;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.side-cell:first-child {
  margin-bottom: 16rpx;
}

.side-caption {
  font-size: 22rpx;
  color: #9C8A76;
  letter-spacing: 2rpx;
}

.side-value {
  margin-top: 8rpx;
  font-size: 30rpx;
}

.type-row {
  display: flex;
}

.type-btn {
  width: 160rpx;
  padding: 14rpx 0;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 6rpx;
  border: 1rpx solid #E3D2BA;
  color: #7A624C;
  margin-right: 20rpx;
}

.type-on {
  color: #FBF5EB;
  border-color: #4A2E1C;
}

.expense-on {
  background: #BF512B;
  border-color: #BF512B;
}

.income-on {
  background: #D98324;
  border-color: #D98324;
}

.amount-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #4A2E1C;
}

.amount-mark {
  font-size: 40rpx;
  color: #9C8A76;
}

.amount-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 60rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.field-label {
  margin: 32rpx 0 16rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #9C8A76;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
}

.note-input {
  width: 100%;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #FFFBF4;
  border-left: 4rpx solid #E3D2BA;
  font-size: 28rpx;
  height: 84rpx;
}

.save-btn {
  margin-top: 48rpx;
  width: 68%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.entry {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0E4D2;
}

.entry-cat {
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.entry-member {
  font-size: 24rpx;
  color: #9C8A76;
}

.entry-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9C8A76;
}

.entry-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
}

.entry-amount {
  font-size: 34rpx;
}

.entry-del {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #C4AF95;
  letter-spacing: 2rpx;
}
